{
    "name": "ChoreographyExtension",
    "uri": "http://example.com/choreography",
    "prefix": "choreography",
    "xml": {
        "tagAlias": "lowerCase"
    },
    "types": [
        {
            "name": "ProcessParticipants",
            "extends": [
                "bpmn:Process"
            ],
            "properties": [
                {
                    "name": "participants",
                    "type": "bpmn:Participant",
                    "isMany": true
                }
            ]
        },
        {
            "name": "Initiator",
            "superClass": [
                "bpmn:Participant"
            ]
        },
        {
            "name": "NonInitiator",
            "superClass": [
                "bpmn:Participant"
            ]
        },
        {
            "name": "ChoreographyTask",
            "superClass": [
                "bpmn:Task"
            ],
            "properties": [
                {
                    "name": "initiatingParticipantRef",
                    "type": "Initiator",
                    "isAttr": true,
                    "isReference": true
                },
                {
                    "name": "participantRef",
                    "type": "NonInitiator",
                    "isMany": true,
                    "isReference": true
                }
            ]
        }
    ]
}