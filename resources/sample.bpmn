<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:conversation="http://example.com/conversation"
  id="Definitions_1"
  targetNamespace="http://bpmn.io/schema/bpmn"
>
  <bpmn2:process id="Process_1">
    <bpmn2:startEvent id="StartEvent_1"/>
    <conversation:ConversationNode id="ConvNode_1" name="Test Node" />
    <conversation:ConversationNode id="ConvNode_2" name="Target Node" />
    <conversation:Participant id="Participant_1" name="Alice" />
    <conversation:ConversationLink id="ConvLink_1" sourceRef="ConvNode_1" targetRef="ConvNode_2" />
  </bpmn2:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="173" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ConvLink_1_di" bpmnElement="ConvLink_1">
        <di:waypoint x="380" y="120" />
        <di:waypoint x="600" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ConvNode_1_di" bpmnElement="ConvNode_1">
        <dc:Bounds x="320" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ConvNode_2_di" bpmnElement="ConvNode_2">
        <dc:Bounds x="540" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1">
        <dc:Bounds x="760" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
